aidl_interface {
    name: "vendor.openfde.launcher",
    vendor_available: true,
    srcs: [
        "vendor/openfde/launcher/IOpenfdeLauncher.aidl",
    ],
    stability: "vintf",
    backend: {
        ndk: {
            enabled: true,
        },
        cpp: {
            enabled: true,
        },
        java: {
            enabled: true,
            platform_apis: true,
        },
    },
    // 首次开发阶段先不冻结：冻结后 v1 会被当成已发布版本，当前实现会被 Soong
    // 编成 V2（-V2-ndk），服务端引用 -V1-ndk 就会报 undefined module。
    // 接口定型、需要生成 aidl_api hash 时再改回 frozen: true。
    frozen: false,
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
}
