aidl_interface {
    name: "vendor.openfde.launcher",
    vendor_available: true,
    srcs: [
        "vendor/openfde/launcher/IOpenfdeLauncher.aidl",
    ],
    stability: "vintf",
    backend: {
        ndk: {
            enabled: true,
        },
        cpp: {
            enabled: true,
        },
        java: {
            enabled: true,
            platform_apis: true,
        },
    },
    // 新接口首次接入：先不声明 versions（声明了 Soong 就会去找 aidl_api/<name>/1 目录，
    // 而该目录只有执行 `m <name>-freeze-api` 之后才会生成）。
    // 接口定型后执行 freeze-api，它会自动补上 versions 和 aidl_api 目录。
}
