aidl_interface {
    name: "vendor.openfde.launcher",
    vendor_available: true,
    srcs: [
        "vendor/openfde/launcher/IOpenfdeLauncher.aidl",
    ],
    // 开发阶段不版本化：不需要 aidl_api dump，也不会出现 "checkapi" 失败。
    // 接口定型后去掉 unstable，执行 `m vendor.openfde.launcher-freeze-api` 生成 v1，
    // 再把调用方依赖改成 -V1-ndk 即可。
    unstable: true,
    backend: {
        ndk: {
            enabled: true,
        },
        cpp: {
            enabled: true,
        },
        java: {
            enabled: true,
            platform_apis: true,
        },
    },
}
