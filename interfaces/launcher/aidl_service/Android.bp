cc_binary {
    name: "vendor.openfde.launcher-service",
    relative_install_path: "hw",
    init_rc: ["vendor.openfde.launcher-service.rc"],
    vintf_fragments: ["vendor.openfde.launcher-service.xml"],
    vendor: true,
    srcs: [
        "main.cpp",
        "OpenfdeLauncherAidl.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "libutils",
    ],
    static_libs: [
        // v1 视为已冻结，当前实现是 V2（Soong 会对 versions:["1"] 自动生成 V2 作为 current）
        "vendor.openfde.launcher-V2-ndk",
    ],
}
