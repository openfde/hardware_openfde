// HAL module implemenation stored in
// hw/<OVERLAY_HARDWARE_MODULE_ID>.<ro.product.board>.so
//
// 合并后的统一 hwcomposer 模块：同时包含 Wayland 与 X11 两个协议后端
//（HwcBackend 子类），运行时按 DISPLAY 环境变量选择后端。
// X11 后端依赖的预编译库（见 x11-prebuilts.bp）仅提供 arm64 版本，
// 因此 x11-backend.cpp 只在 arm64 上编译链接。
cc_library_shared {
    name: "hwcomposer.openfde",
    relative_install_path: "hw",
    vendor: true,
    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "libhidltransport",
        "libhwbinder",
        "libsync",
        "libui",
        "libdrm",
        "libEGL",
        "libGLESv2",
        "vendor.openfde.display@1.0",
        "vendor.openfde.display@1.1",
        "vendor.openfde.task@1.0",
        "vendor.openfde.window@1.0",
        "vendor.openfde.window@1.1",
        "vendor.openfde.window@1.2",
    ],
    static_libs: [
        "libwayland_client_static",
        "libffi",
        "libwayland_extension_client_protocols",
        "libxkbcommon",
    ],
    srcs: [
        "extension.cpp",
        "hwcomposer.cpp",
        "hwc_backend.cpp",
        "wayland-backend.cpp",
        "OpenfdeWindow.cpp",
        "egl-tools.cpp",
    ],
    header_libs: [
        "libsystem_headers",
        "minigbm_headers",
    ],
    include_dirs: [
        "system/core",
        "system/core/libsync",
        "system/core/libsync/include",
        "device/generic/goldfish-opengl/shared/gralloc_cb/include",
        "device/generic/goldfish-opengl/shared/qemupipe/include",
        "device/generic/goldfish-opengl/shared/qemupipe/include-types",
    ],
    local_include_dirs: [
        "include"
    ],
    arch : {
        arm64: {
            srcs: [
                "x11-backend.cpp",
            ],
            shared_libs: [
                "libX11",
                "libX11-xcb",
                "libXrender",
                "libxcb",
                "libxcb-xinput",
                "libxcb-randr",
                "libxcb-imdkit",
                "libxcb-util",
                "libxcb-dri3",
                "libxcb-shape",
            ],
        },
    },
    cflags: [
        "-DLOG_TAG=\"hwcomposer\"",
        "-Wall",
        "-Werror",
        "-Wno-writable-strings",
    ],
    generated_sources: ["wayland_android_client_protocol_sources"],
    generated_headers: ["wayland_android_client_protocol_headers"],
}

// Generate wayland-android protocol source file
genrule {
    name: "wayland_android_client_protocol_sources",
    srcs: ["wayland-android.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) code < $(in) > $(out)",
    out: ["wayland-android-client-protocol.c"],
}
// Generate wayland-android protocol header file
genrule {
    name: "wayland_android_client_protocol_headers",
    srcs: ["wayland-android.xml"],
    tools: ["wayland_scanner"],
    cmd: "$(location wayland_scanner) client-header < $(in) > $(out)",
    out: ["wayland-android-client-protocol.h"],
}
